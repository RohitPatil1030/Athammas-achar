# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp sender in E.164. Sandbox example: whatsapp:+14155238886
# The whatsapp: prefix is optional; the API route adds it when missing.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Shop owner who receives order inquiries and waitlist notes.
OWNER_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# Inquiries are emailed here from the server. The visitor is not sent to their mail app.
INQUIRY_EMAIL=you@example.com

# Code printed in the FormSubmit email. Use that code, not the Activate Form button.
# The button opens a page with no token ("Not a valid link").
FORMSUBMIT_ID=

# Testing without Twilio. From the kitchen phone, WhatsApp +34 623 78 64 49
# the message: I allow callmebot to send me messages
# Paste the API key that phone receives. The site then sends inquiries to
# OWNER_WHATSAPP_NUMBER itself. The visitor's WhatsApp is not opened.
CALLMEBOT_API_KEY=
